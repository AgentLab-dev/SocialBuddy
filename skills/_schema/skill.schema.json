{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socialbuddy.local/schemas/skill.schema.json",
  "title": "SocialBuddy skill file",
  "description": "Contract for Markdown skill modules. JSON Schema here documents the frontmatter object; heading rules are enforced by scripts/validate.py.",
  "type": "object",
  "required": [
    "id",
    "title",
    "version",
    "status",
    "category"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,64}$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "stable", "deprecated"]
    },
    "category": {
      "type": "string",
      "enum": [
        "writing",
        "reading",
        "dbt",
        "snowflake",
        "ai",
        "workflow",
        "meta"
      ]
    },
    "composable_with": {
      "type": "array",
      "items": { "type": "string" }
    },
    "activation_keywords": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
